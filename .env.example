# DigitalOcean serverless inference (OpenAI-compatible)
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DO_MODEL_ACCESS_KEY=your-model-access-key-here

# Model that answers the user
PRIMARY_MODEL=llama3.3-70b-instruct
# Model that silently receives the mirrored payload
CANDIDATE_MODEL=openai-gpt-oss-120b

# Optional timeouts (Spring Duration format)
PRIMARY_TIMEOUT=60s
CANDIDATE_TIMEOUT=90s

# Bounded background shadow evaluation (load shedding under burst traffic)
# Concurrent candidate calls + queued tasks; further offers are dropped.
SHADOW_MAX_CONCURRENCY=32
SHADOW_QUEUE_CAPACITY=128

# Initial % of chat requests mirrored to the candidate (runtime-tunable via PUT /config)
SHADOW_ROUTING_PERCENTAGE=100
# SQLite file for persisted primary/candidate mismatches
SHADOW_SQLITE_PATH=./data/shadow-mismatches.db
